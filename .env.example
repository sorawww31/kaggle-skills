# Kaggle Skills Environment Variables
# .env.example をコピーして .env を作成し、実際の値を記入してください
# $set -a; source .env; set +a で読み込めます

# Required: Kaggle API Token
# 取得方法: https://kaggle.com → Settings → API → Create New API Token
# ダウンロードされた kaggle.json から key の値をコピー
export KAGGLE_API_TOKEN="KGAT_XXX"

# Optional: Competition name
export COMPETITION="birdclef-2026"

# Optional: Kaggle user name
export KAGGLE_USER_NAME="user_name"